---
import type { Project } from '../config/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabel = {
  active: '\u25CF Active',
  beta: '\u25CF Beta',
  wip: '\u25CF WIP',
  hold: '\u25CF Hold',
  paused: '\u25CF Paused',
};

const statusClass = {
  active: 'status-badge status-active-badge',
  beta: 'status-badge status-beta-badge',
  wip: 'status-badge status-wip-badge',
  hold: 'status-badge status-hold-badge',
  paused: 'status-badge status-paused-badge',
};

const ariaStatus = {
  active: 'Activo',
  beta: 'Beta',
  wip: 'En progreso',
  hold: 'En espera',
  paused: 'Pausado',
};
---

<article
  class={`project-card${project.status === 'paused' ? ' paused' : ''}${project.href ? ' clickable' : ''}`}
  aria-label={`Proyecto ${project.title}`}
>
  {project.href ? (
    <a href={project.href} target="_blank" rel="noopener noreferrer" class="project-card-link" aria-label={`Abrir ${project.title}`}>
      <div class="project-top">
        <span class="project-icon" aria-hidden="true">{project.icon}</span>
        <div class="project-title-wrap">
          <h3 class="project-title">{project.title}</h3>
          <p class="project-tagline" data-es={project.tagline} data-en={project.taglineEN}>
            {project.tagline}
          </p>
        </div>
        <span class={statusClass[project.status]} aria-label={`Estado: ${ariaStatus[project.status]}`}>
          {statusLabel[project.status]}
        </span>
      </div>
      <div class="project-stack">
        {project.stack.map((chip, i) => (
          <span class={`stack-chip${i === 0 ? ' primary' : ''}`}>{chip}</span>
        ))}
      </div>
    </a>
  ) : (
    <>
      <div class="project-top">
        <span class="project-icon" aria-hidden="true">{project.icon}</span>
        <div class="project-title-wrap">
          <h3 class="project-title">{project.title}</h3>
          <p class="project-tagline" data-es={project.tagline} data-en={project.taglineEN}>
            {project.tagline}
          </p>
        </div>
        <span class={statusClass[project.status]} aria-label={`Estado: ${ariaStatus[project.status]}`}>
          {statusLabel[project.status]}
        </span>
      </div>
      <div class="project-stack">
        {project.stack.map((chip, i) => (
          <span class={`stack-chip${i === 0 ? ' primary' : ''}`}>{chip}</span>
        ))}
      </div>
    </>
  )}
</article>
