---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import LinkCard from '../components/LinkCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LiveCommitFeed from '../components/LiveCommitFeed';
import ContactForm from '../components/ContactForm';
import { LINKS } from '../config/links';
import { COPY } from '../config/i18n';
import { PROJECTS } from '../config/projects';

const es = COPY.es;
const en = COPY.en;
---

<BaseLayout>

  <!-- Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ NAVBAR Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
  <Navbar />

  <!-- Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ MAIN Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
  <main id="about">
    <div class="container">

      <!-- Ã¢â€â‚¬Ã¢â€â‚¬ HERO Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
      <Hero />

      <!-- DIVIDER + EXPLORE label -->
      <div style="position:relative; margin: 0 0 24px;">
        <div class="divider" style="margin:0"></div>
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:var(--bg); padding:0 16px;">
          <span
            class="label-section"
            data-es={es.sections.explore}
            data-en={en.sections.explore}
          >
            {es.sections.explore}
          </span>
        </div>
      </div>

      <!-- Ã¢â€â‚¬Ã¢â€â‚¬ QUICK LINKS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
      <section id="blog" aria-label="Links de interes" style="margin-bottom: var(--sp-3xl);">
        <div class="links-grid">

          <LinkCard
            icon={'\u270D\uFE0F'}
            titleEs={es.links.blog.title}
            titleEn={en.links.blog.title}
            descEs={es.links.blog.desc}
            descEn={en.links.blog.desc}
            ctaEs={es.cta.read}
            ctaEn={en.cta.read}
            href={LINKS.blog}
            ariaLabel="Ir al blog"
          />

          <LinkCard
            icon={'\u{1F4BC}'}
            titleEs={es.links.linkedin.title}
            titleEn={en.links.linkedin.title}
            descEs={es.links.linkedin.desc}
            descEn={en.links.linkedin.desc}
            ctaEs={es.cta.connect}
            ctaEn={en.cta.connect}
            href={LINKS.linkedin}
            ariaLabel="Ver perfil de LinkedIn"
          />

          <LinkCard
            icon={'\u26A1'}
            titleEs={es.links.github.title}
            titleEn={en.links.github.title}
            descEs={es.links.github.desc}
            descEn={en.links.github.desc}
            ctaEs={es.cta.view}
            ctaEn={en.cta.view}
            href={LINKS.github}
            ariaLabel="Ver perfil de GitHub"
          />

          <LinkCard
            icon={'\u25B6\uFE0F'}
            titleEs={es.links.youtube.title}
            titleEn={en.links.youtube.title}
            descEs={es.links.youtube.desc}
            descEn={en.links.youtube.desc}
            ctaEs={es.cta.soon}
            ctaEn={en.cta.soon}
            disabled={true}
            ariaLabel="YouTube proximamente"
          />

        </div>
      </section>

      <!-- Ã¢â€â‚¬Ã¢â€â‚¬ BOTTOM ROW: Feed + Projects Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
      <div class="bottom-row" style="margin-bottom: var(--sp-4xl);">

        <!-- Live GitHub Feed -->
        <section aria-label="Actividad reciente de GitHub">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
            <span
              class="label-section"
              data-es={es.sections.liveActivity}
              data-en={en.sections.liveActivity}
            >
              {es.sections.liveActivity}
            </span>
            <span class="live-dot" aria-hidden="true"></span>
            <span
              style="font-size:12px; color:var(--text-muted);"
              data-es={es.sections.githubLive}
              data-en={en.sections.githubLive}
            >
              {es.sections.githubLive}
            </span>
          </div>

          <LiveCommitFeed
            client:load
            feedUrl={LINKS.activityFeed}
            limit={7}
            pollInterval={60000}
          />
        </section>

        <!-- Current Projects -->
        <section id="projects" aria-label="Proyectos actuales">
          <div class="projects-heading" style="margin-bottom:12px;">
            <span
              class="label-section"
              data-es={es.sections.buildingNow}
              data-en={en.sections.buildingNow}
            >
              {es.sections.buildingNow}
            </span>
            <span
              class="projects-scroll-hint"
              data-es="scroll"
              data-en="scroll"
              aria-hidden="true"
            >
              scroll
            </span>
          </div>

          <div class="projects-scroll-shell" data-projects-scroll-shell>
            <div class="projects-scrollbox">
              <div class="projects-stack" data-projects-scroll>
                {PROJECTS.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
              <div class="projects-scroll-fade top" aria-hidden="true"></div>
              <div class="projects-scroll-fade bottom" aria-hidden="true"></div>
            </div>
          </div>
        </section>

      </div>

      <!-- Ã¢â€â‚¬Ã¢â€â‚¬ CONTACT Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
      <div style="position:relative; margin: 0 0 24px;">
        <div class="divider" style="margin:0"></div>
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:var(--bg); padding:0 16px;">
          <span
            class="label-section"
            data-es={es.sections.contact}
            data-en={en.sections.contact}
          >
            {es.sections.contact}
          </span>
        </div>
      </div>

      <section id="contact" aria-label="Contacto" style="margin-bottom: var(--sp-4xl);">
        <ContactForm
          client:load
          endpoint={LINKS.formspree}
          es={es.contact}
          en={en.contact}
        />
      </section>

    </div>
  </main>

  <!-- Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ FOOTER Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
  <footer class="footer" role="contentinfo">
    <div class="container" style="display:flex; justify-content:space-between; align-items:center; width:100%;">
      <span
        class="footer-text"
        data-es={es.footer}
        data-en={en.footer}
      >
        {es.footer}
      </span>
      <span class="footer-text" style="font-size:12px; color:var(--text-disabled);">
        virgilitech.dev &middot; 2026
      </span>
    </div>
  </footer>

  <!-- Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ i18n INIT SCRIPT Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
  <script>
    (function () {
      const saved = localStorage.getItem('lang') as 'es' | 'en' | null;
      const lang: 'es' | 'en' = saved === 'en' ? 'en' : 'es';

      if (lang === 'en') {
        document.documentElement.lang = 'en';
        document.querySelectorAll<HTMLElement>('[data-es][data-en]').forEach((el) => {
          const val = el.dataset['en'];
          if (val) el.textContent = val;
        });
      }

      window.addEventListener('langchange', (e: Event) => {
        const l = (e as CustomEvent<'es' | 'en'>).detail;
        document.documentElement.lang = l;
        document.querySelectorAll<HTMLElement>('[data-es][data-en]').forEach((el) => {
          const val = el.dataset[l];
          if (val) el.textContent = val;
        });
      });
    })();
  </script>

  <script>
    (function () {
      const shell = document.querySelector<HTMLElement>('[data-projects-scroll-shell]');
      const stack = document.querySelector<HTMLElement>('[data-projects-scroll]');
      if (!shell || !stack) return;

      const visibleCards = 3;
      const previewFraction = 0.2;

      const syncState = () => {
        const maxScroll = stack.scrollHeight - stack.clientHeight;
        shell.dataset.overflow = maxScroll > 1 ? 'true' : 'false';
        shell.dataset.atTop = stack.scrollTop <= 1 ? 'true' : 'false';
        shell.dataset.atBottom = stack.scrollTop >= maxScroll - 1 ? 'true' : 'false';
      };

      const updateMaxHeight = () => {
        const cards = Array.from(stack.querySelectorAll<HTMLElement>('.project-card'));
        if (cards.length === 0) return;

        const count = Math.min(visibleCards, cards.length);
        const style = getComputedStyle(stack);
        const gap = Number.parseFloat(style.rowGap || style.gap || '0') || 0;

        let fullCardsHeight = 0;
        for (let i = 0; i < count; i++) {
          fullCardsHeight += cards[i].offsetHeight;
        }

        if (count > 1) {
          fullCardsHeight += gap * (count - 1);
        }

        const previewCard = cards[visibleCards];
        const previewHeight = previewCard ? (previewCard.offsetHeight * previewFraction) + gap : 0;
        const maxHeight = Math.ceil(fullCardsHeight + previewHeight + 6);

        stack.style.maxHeight = `${maxHeight}px`;
        syncState();
      };

      stack.addEventListener('scroll', syncState, { passive: true });
      window.addEventListener('resize', updateMaxHeight);
      window.addEventListener('langchange', updateMaxHeight as EventListener);
      window.addEventListener('load', updateMaxHeight);
      shell.addEventListener(
        'wheel',
        (event) => {
          if (shell.dataset.overflow !== 'true') return;
          const targetNode = event.target as Node | null;
          if (targetNode && stack.contains(targetNode)) return;
          stack.scrollTop += event.deltaY;
          event.preventDefault();
        },
        { passive: false },
      );

      updateMaxHeight();
      requestAnimationFrame(syncState);
    })();
  </script>

</BaseLayout>
